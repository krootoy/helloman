# Секретный ключ для шифрования API ключей LLM в базе данных
RECALL_SECRET_KEY=change-this-to-a-long-random-secret

# Опционально: подключение к постоянной облачной SQLite базе данных Turso
# (Рекомендуется для продакшена на Vercel, так как серверлесс функции не сохраняют локальные файлы)
# Бесплатная регистрация на https://turso.tech/
# Команды для создания:
#   turso db create recall
#   turso db tokens create recall
# TURSO_DATABASE_URL=libsql://recall-[ваш-аккаунт].turso.io
# TURSO_AUTH_TOKEN=ваш-токен-turso

# Таймаут запроса к модели в секундах (лимит Vercel Hobby — 60 сек)
RECALL_LLM_TIMEOUT=55

# Опционально: разрешённые домены CORS (через запятую). Домены *.vercel.app и текущий origin разрешены автоматически.
# RECALL_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
